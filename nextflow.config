manifest {
  name            = 'PlotTrellis-wf'
  description     = 'Processes RNA-seq, ATAC-seq, ChIP-seq, CUT&RUN, CUT&Tag and Hi-C data for the PlotTrellis app'
  mainScript      = 'main.nf'
  nextflowVersion = '!>=25.04.0'
  version         = '1.0.1'
}

params {
  // Required
  samplesheet = null          // .xlsx (or .csv) samplesheet with absolute FASTQ paths, or GEO sample accessions (GSM)
  outdir      = null          // results folder
  species     = null          // 'human' (GRCh38) or 'mouse' (GRCm39)

  // What to run
  assay       = 'all'         // comma-separated subset of: rna,atac,chip,cutrun,cuttag,hic

  // Scratch folder for the work files, references and containers. Default: $PLOTTRELLIS_SCRATCH, else
  // /vast/scratch/users/$USER/plottrellis when /vast/scratch/users/$USER exists, else plottrellis_scratch in the launch folder
  scratch     = System.getenv('PLOTTRELLIS_SCRATCH') ?: (new File("/vast/scratch/users/${System.getenv('USER')}").isDirectory() ? "/vast/scratch/users/${System.getenv('USER')}/plottrellis" : "${System.getProperty('user.dir')}/plottrellis_scratch")

  // Samples downloaded from GEO (samplesheet rows with a GSM and no FASTQ files)
  keepDownloads = true        // keep the downloaded FASTQ files in <outdir>/fastq

  // Read trimming (off by default)
  trim        = false         // true: fastp for every assay; or a comma-separated list of assays
  trimArgs    = ''            // extra options added to every 'fastp' call

  // References
  gencode     = 'latest'      // GENCODE release, e.g. 50 (human) or M39 (mouse)
  refDir      = "${params.scratch}/references"  // GENCODE files and indexes, reused by later runs
  minimap2IndexDna = null     // pre-built minimap2 index (-x sr); built if not given
  minimap2IndexRna = null     // pre-built minimap2 index (-x splice:sr); built if not given
  salmonIndex = null          // pre-built decoy-aware Salmon index; built if not given
  bwaIndex    = null          // pre-built bwa index (folder with the index files, for Hi-C); built if not given

  // RNA-seq
  salmonGibbs = 100           // --numGibbsSamples

  // DNA-based assays
  blacklist   = false         // true: excluderanges blacklist; or a path to your own BED file
  peakType    = 'narrow'      // default when the samplesheet 'peak_type' column is empty
  macs3Args   = ''            // extra options added to every 'macs3 callpeak' call
  effectiveGenomeSize = null  // default: deepTools non-N genome size for the species

  // Hi-C
  hicDedup    = true          // remove duplicate pairs (pairtools dedup)
  pairtoolsParseArgs = ''     // extra options added to every 'pairtools parse' call, e.g. '--min-mapq 30'
  pairtoolsSelect = ''        // pairtools select expression applied to each group's pairs before the .hic is made
  juicerPreArgs = ''          // extra options added to every 'juicer_tools pre' call

  // Coverage tracks (all assays)
  normalizeWithAutosome = false  // only use autosomes to compute the normalization factor

  // Scheduler (SLURM by default; PBS, LSF and SGE through profiles)
  partition   = null          // SLURM partition or queue for all jobs; default: the scheduler's default
  maxCpus     = 56            // no job asks for more than this
  maxMemory   = '480.GB'
  maxTime     = '14.d'
}

// Nextflow work files (BAMs, pairs, merged and trimmed FASTQs). -work-dir (-w) on the command line takes precedence
workDir = "${params.scratch}/work"

process {
  executor      = 'slurm'
  queue         = params.partition
  cache         = 'lenient'
  shell         = ['/bin/bash', '-euo', 'pipefail']
  errorStrategy = { task.exitStatus in [104, 134, 137, 139, 140, 143, 247] ? 'retry' : 'finish' }
  maxRetries    = 2
  resourceLimits = [cpus: params.maxCpus as int, memory: params.maxMemory as String, time: params.maxTime as String]
}

executor {
  queueSize         = 100
  queueStatInterval = '10 sec'
  pollInterval      = '10 sec'
  submitRateLimit   = '10sec'
}

// Container engine: Apptainer by default; see the profiles below for the alternatives
apptainer {
  enabled     = true
  autoMounts  = true
  cacheDir    = System.getenv('NXF_APPTAINER_CACHEDIR') ?: "${params.scratch}/containers"
  pullTimeout = '3h'
}
// A user or site Nextflow config (e.g. ~/.nextflow/config) may turn Singularity on, which would take precedence over Apptainer
singularity.enabled = false

profiles {
  // Other schedulers instead of SLURM (--partition then names the queue)
  pbspro {
    process.executor = 'pbspro'
  }
  pbs {
    process.executor = 'pbs'          // PBS/Torque
  }
  lsf {
    process.executor = 'lsf'
  }
  sge {
    process.executor = 'sge'          // SGE, UGE, Altair Grid Engine
    process.penv     = 'smp'          // parallel environment for multi-CPU jobs (list them with 'qconf -spl')
  }
  // Run every step on the current computer instead of submitting jobs
  local {
    process.executor = 'local'
  }
  singularity {
    apptainer.enabled     = false
    singularity.enabled     = true
    singularity.autoMounts  = true
    singularity.cacheDir    = System.getenv('NXF_SINGULARITY_CACHEDIR') ?: "${params.scratch}/containers"
    singularity.pullTimeout = '3h'
  }
  docker {
    apptainer.enabled  = false
    singularity.enabled = false        // a site-wide Nextflow config may turn Singularity on
    docker.enabled     = true
    docker.runOptions  = '-u $(id -u):$(id -g)'
  }
  podman {
    apptainer.enabled  = false
    singularity.enabled = false
    podman.enabled     = true
  }
}

report {
  enabled   = true
  overwrite = true
  file      = "${params.outdir}/logs/pipeline_info/report.html"
}

timeline {
  enabled   = true
  overwrite = true
  file      = "${params.outdir}/logs/pipeline_info/timeline.html"
}

trace {
  enabled   = true
  overwrite = true
  file      = "${params.outdir}/logs/pipeline_info/trace.txt"
}

// Copies each task's .command.* files into <outdir>/logs/tasks/<workflow>/<process>/<tag>
// Adapted from zichner (https://github.com/nextflow-io/nextflow/issues/1166#issuecomment-502467562)
process.afterScript = {
  def logMainDir = workflow.launchDir.resolve(params.outdir.toString()).toString() + "/logs/tasks"
  def logSubDir = task.name.replace(" (null)", "").replaceAll("[()]", "").replace(":", "/").replace(" ", "/")
  def logDir = logMainDir + "/" + logSubDir

  def cmd = "ls -alR --full-time > .command.ls; "
  cmd += "mkdir -p nxf_log; "
  cmd += "for file in .command.*; do cp -a \${file} nxf_log/\${file#.}.txt; done; "
  cmd += "mkdir -p ${logDir}; cp -a nxf_log/*.txt ${logDir}/; "
  cmd
}
